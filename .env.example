###############################################################################
#  Cohesive LLM — IZS Bioinformatics AI Platform                              #
#  Environment Configuration Template (.env.example)                          #
###############################################################################

# ─── SERVER & AUTHENTICATION ─────────────────────────────────────────────────
PORT=8080
AUTH_BYPASS=true

# ─── PLUGIN & RETRIEVAL CONFIGURATION ─────────────────────────────────────────
NF_AGENT_PLUGIN=izs
VECTOR_DB_TYPE=faiss

# ─── MAIN LLM CONFIGURATION (Local vLLM / OpenAI-Compatible) ──────────────────
LLM_PROVIDER=openai
LLM_MODEL=Qwen/Qwen3.8-27B-FP8
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=not-needed

# ─── JUDGE LLM CONFIGURATION (Benchmark Evaluation & Verification) ───────────
JUDGE_PROVIDER=openai
JUDGE_MODEL=Qwen/Qwen3.8-27B-FP8
JUDGE_BASE_URL=http://localhost:8000/v1

# ─── OPTIONAL CLOUD PROVIDER KEYS ────────────────────────────────────────────
# MISTRAL_API_KEY=your_mistral_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# ─── RUNTIME & ACCELERATION FLAGS ────────────────────────────────────────────
VLLM_ENFORCE_STRICT_TOOL_CALLING=1
FLASHINFER_DISABLE_VERSION_CHECK=1

# ─── NEXTFLOW & FRAMEWORK PATHS ──────────────────────────────────────────────
NGSMANAGER_DIR=plugins/izs/cohesive-ngsmanager
NF_FRAMEWORK_DIR=plugins/izs/cohesive-ngsmanager
NF_COMPONENTS_DIR=plugins/izs/cohesive-ngsmanager/steps
NF_TEMPLATES_DIR=plugins/izs/cohesive-ngsmanager/modules
NF_RESOURCES_DIR=plugins/izs/cohesive-ngsmanager/functions

# ─── NEXTFLOW RUNTIME ENVIRONMENT (Optional for local validation) ────────────
# NXF_VER=22.10.1
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home
