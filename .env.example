###############################################################################
#  Cohesive LLM — IZS Bioinformatics AI Platform                              #
#  Environment Configuration Template                                         #
###############################################################################

# ─── DEPLOYMENT & NETWORKING ─────────────────────────────────────────────────
# DOMAIN: hostname or domain users will use to access the platform
#   localhost                  → local development
#   server.izs.intra           → internal IZS network (intranet)
#   ai.example.com             → public domain
DOMAIN=localhost

# HTTPS_MODE: how Caddy handles TLS
#   off       → HTTP only (port 80). Use for localhost or simple intranet.
#   internal  → Self-signed cert via Caddy local CA.
#   auto      → Automatic Let's Encrypt cert.
HTTPS_MODE=off
ACME_EMAIL=admin@example.com

# ─── CADDY HOST PORTS ────────────────────────────────────────────────────────
CADDY_HOST_PORT=9000
CADDY_HOST_HTTPS_PORT=9443

# ─── REVERSE-PROXY SUB-PATH ──────────────────────────────────────────────────
#   BASE_PATH      injected into HTML <base href>. Must end with "/".
#                    /        → site root (dev)
#                    /llm/    → app behind /llm
#   PROXY_PREFIX   prefix handled by Caddy
#                    (empty)  → site root or upstream proxy strips
#                    /llm     → Caddy serves app at /llm/*
BASE_PATH=/
PROXY_PREFIX=

# ─── BACKEND LLM & EMBEDDINGS ────────────────────────────────────────────────
# Default: Localhost vLLM / Ollama endpoint (Zero external cloud API keys needed)
LLM_PROVIDER=local
LLM_MODEL=labs-devstral-small-2512
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_KEY=not-needed

# Optional Cloud Providers (if switching from local):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_API_KEY=

# ─── ACTIVE DOMAIN PLUGIN & FRAMEWORK ────────────────────────────────────────
ACTIVE_PLUGIN=izs
NGSMANAGER_REPO=https://github.com/genpat-it/cohesive-ngsmanager.git
NGSMANAGER_BRANCH=main
NGSMANAGER_DIR=/ngsmanager

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Production (Docker Compose): postgresql+psycopg2://cohesive:cohesive_dev_password@postgres:5432/cohesive
# Local Dev standalone fallback: sqlite:///./cohesive.db
DATABASE_URL=sqlite:///./cohesive.db
POSTGRES_USER=cohesive
POSTGRES_PASSWORD=cohesive_dev_password
POSTGRES_DB=cohesive

# ─── AUTHENTICATION & LOCAL BYPASS ───────────────────────────────────────────
# Set AUTH_BYPASS=true for local development to skip login screen and cookies:
AUTH_BYPASS=true

# JWT Secret for production (generate with: openssl rand -hex 32)
JWT_SECRET=replace_me_with_openssl_rand_hex_32

# Initial demo user, seeded automatically on startup
DEMO_USER=demo
DEMO_PASSWORD=change_me_please

# ─── SECURITY & COOKIES ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
COOKIE_SECURE=false
COOKIE_PATH=/
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=5/minute
