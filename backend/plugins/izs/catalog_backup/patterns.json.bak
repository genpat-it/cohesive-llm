    {
      "id": "conditional_file_filtering_with_inline_python",
      "title": "Conditional File Filtering with Inline Python",
      "description": "This pattern shows how to perform conditional filtering of file contents using inline Python within a Nextflow process. It reads input data, applies numerical thresholds to specific columns, and writes filtered results to a new file.",
      "use_cases": [
        "Filtering tabular data based on numeric thresholds in specific columns",
        "Quality filtering of bioinformatics results (e.g., coverage/identity thresholds)",
