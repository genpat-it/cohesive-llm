      "groovy_code": "getInput()\n    .cross(getKingdom()) { extractKey(it) }\n    .cross(getReferenceOptional('gb')) { extractKey(it) }\n    .map { it.flatten() }\n    .map { [ it[0], it[1], it[3], it[5], it[6], it[7] ] }\n    .set { input }",
      "caveats": [
