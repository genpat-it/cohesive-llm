    {
      "id": "conditional_tuple_unpacking_with_cross_operator",
      "title": "Conditional Tuple Unpacking with Cross Operator",
      "description": "This pattern demonstrates how to use the `.cross()` operator to combine multiple channels and then conditionally unpack and restructure the resulting tuples. It is particularly useful when you need to combine optional inputs with mandatory ones and then reorder or filter the combined data.",
      "use_cases": [
