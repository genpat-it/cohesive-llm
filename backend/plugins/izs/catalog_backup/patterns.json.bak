    {
      "id": "conditional_channel_branching_with_emit",
      "title": "Conditional Channel Branching with Emit",
      "description": "This pattern demonstrates how to use the `emit` qualifier in process outputs to create named channels for specific outputs, allowing for selective downstream processing. This is particularly useful when a process generates multiple outputs, but only some are needed for subsequent steps.",
      "use_cases": [
