      "id": "conditional_channel_aggregation_with_validation",
      "title": "Conditional Channel Aggregation with Validation",
      "description": "This pattern demonstrates how to conditionally aggregate channels based on validation logic. It includes a function `canBeAggregated` that checks if the input references match expected values and returns a boolean. This is useful for ensuring data consistency before aggregation.",
      "use_cases": [
        "When you need to validate input data before aggregation to ensure consistency.",
        "When working with multiple references that need to be checked against a predefined list."
      ],
      "groovy_code": "def canBeAggregated(actual) {\n    try {\n      expected = getReferenceCodes()\n      if (expected.size() < 2) {\n          return false\n      }\n      if (actual.size() != expected.size()) {\n        log.warn \"expected ${expected.size()} references, got: ${actual.size()}\"\n        return false\n      }\n      if (actual.any {!expected.contains(it)}) {\n        log.warn \"there is some unexpected value in ${actual} (values should be: ${expected})\"\n        return false\n      }\n      return true\n    } catch(Throwable t) {\n        log.warn \"canBeAggregated: unexpected exception: ${t.asString()}\"\n        return false\n    }\n}",
      "caveats": [
