      "groovy_code": "\"\"\"\n  #!/usr/bin/env python3\n\n  new = open(\"${base}_COV${coverage}_ID${identity}_abricate_calls.txt\", \"w\")\n  res = open(\"${calls}\", 'r').readlines()\n  new.write(res[0])\n  for l in res:\n      try:\n          if float(l.split(\"\\t\")[9]) >= ${coverage} and float(l.split(\"\\t\")[10]) >= ${identity}:\n              new.write(l.replace(l.split(\"\\t\")[0],\"${calls}\"))\n      except:\n          pass\n  new.close()\n\"\"\"",
      "caveats": [
