    {
      "id": "conditional_process_chaining_with_branch",
      "title": "Conditional Process Chaining with Branch",
      "description": "This pattern shows how to chain processes conditionally using the `when` clause in a process definition. The `minimap2` process only executes if the input reads are compatible with the specified sequence type (e.g., 'nanopore'), ensuring resources are not wasted on incompatible data.",
      "use_cases": [
